# 会话签名密钥（必填）：使用强随机值，生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：更换该值会使所有已登录用户会话失效，且切勿提交到 git。
SESSION_SECRET=

# 通义千问 DashScope API Key（聊天功能使用）
DASHSCOPE_API_KEY=

# Supabase Storage（商品图片上传，publishable key 可公开，在 Supabase 控制台 API 设置查看）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
